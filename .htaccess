# Beranda dilayani oleh index.php (server-rendered dari database),
# bukan index.html lagi. Eksplisit supaya tidak bergantung urutan
# default server.
<IfModule mod_dir.c>
  DirectoryIndex index.php index.html
</IfModule>

# Proteksi Basic Auth untuk admin.html dan endpoint ganti password.
# File .htpasswd tidak lagi dikelola lewat Git (lihat catatan di .gitignore)
# supaya perubahan password lewat panel admin tidak tertimpa saat deploy.
<FilesMatch "^(admin\.html|admin\.php|edit-portfolio\.php|change-password\.php|upload-photo\.php|save-data\.php|migrate-to-db\.php|setup-schema\.php|get-pages\.php|save-page\.php|import-pages\.php|seed-perawatan-content\.php|fix-content-2026-08-10\.php|seed-artikel-biaya-perawatan\.php|seed-artikel-jadwal-perawatan\.php|seed-artikel-musim-hujan\.php|seed-artikel-ph-ideal\.php|seed-artikel-backwash-filter\.php|seed-artikel-pompa-diganti\.php|seed-artikel-vila-jarang-dipakai\.php|seed-artikel-air-hijau\.php|seed-artikel-frekuensi-cek-ph\.php|seed-artikel-kesalahan-umum\.php|fix-homepage-h1-spacing\.php|fix-service-pembuatan-kolam-baru\.php|fix-area-bogor-kota\.php|fix-problem-perbaikan-kebocoran\.php|migrate-money-page-perawatan\.php|optimize-remaining-services\.php|optimize-remaining-areas\.php|optimize-portfolio-perawatan\.php|fix-orphan-internal-links\.php|delete-page\.php|get-page-sections\.php|save-page-sections\.php)$">
  AuthType Basic
  AuthName "Admin - Jasa Kolam Renang Bogor"
  AuthUserFile /home/u740832685/domains/jasakolamrenangbogor.com/public_html/.htpasswd
  Require valid-user
</FilesMatch>

# db-config.php (kredensial database) dan inc/*.php (kode internal) tidak
# boleh diakses langsung lewat browser, hanya lewat require di PHP lain.
<FilesMatch "^db-config(\.example)?\.php$">
  Require all denied
</FilesMatch>
<IfModule mod_alias.c>
  RedirectMatch 403 ^/inc/.*\.php$
</IfModule>

# Cegah browser memakai versi lama JS/CSS yang ter-cache setelah situs
# diperbarui (mis. logika panel admin berubah tapi browser masih pakai
# admin.js versi sebelumnya). Browser tetap boleh menyimpan salinan,
# tapi wajib cek dulu ke server apakah ada versi lebih baru (revalidate).
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Halaman area lama (file statis) dipindah ke struktur URL SEO baru.
# index.html juga dipindah (sekarang index.php) — konsolidasi sinyal SEO
# ke "/" dan menjaga link/bookmark lama yang mungkin sudah ter-index.
<IfModule mod_alias.c>
  Redirect 301 /area-sentul.html /area/sentul/
  Redirect 301 /area-cibinong.html /area/cibinong/
  Redirect 301 /area-bogor-kota.html /area/bogor-kota/
  Redirect 301 /area-puncak.html /area/puncak/
  Redirect 301 /index.html /

  # Phase 7 (2026-08-11): migrasi money page "Jasa Perawatan Kolam
  # Renang" ke URL yang lebih menargetkan intent utamanya.
  Redirect 301 /layanan/perawatan-pembersihan-rutin/ /layanan/jasa-perawatan-kolam-renang/
</IfModule>

# Routing dinamis untuk 300 halaman SEO/GEO (area, kombinasi, layanan,
# artikel, portofolio, halaman pendukung) — dibaca dari database lewat
# page-router.php, bukan file per halaman. sitemap.xml juga dihasilkan
# dinamis (bukan file statis) supaya selalu akurat & kebal dari deploy.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Konsolidasi domain: www dan non-www sebelumnya sama-sama hidup
  # sendiri-sendiri (200 OK, tanpa redirect) — Google melihatnya sebagai
  # dua alamat terpisah untuk tiap halaman (duplicate content). Domain
  # resmi = tanpa www, sesuai canonical tag & data bisnis.
  RewriteCond %{HTTP_HOST} ^www\.jasakolamrenangbogor\.com$ [NC]
  RewriteRule ^(.*)$ https://jasakolamrenangbogor.com/$1 [R=301,L]

  RewriteRule ^sitemap\.xml$ sitemap-generator.php [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ page-router.php?path=$1 [L,QSA]
</IfModule>
